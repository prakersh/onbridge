# Dependencies
node_modules/

# Build output
dist/
.output/
*.tsbuildinfo

# WXT generated
packages/extension/.wxt/

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# AI agent config (local paths)
.mcp.json
.claude/
CLAUDE.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Build artifacts (app.sh --package output)
artifacts/

# Gemini
.gemini/

# Research notes — local only, deliberately not checked in
RESEARCH-*.md

# Local capture material from bug investigations — screen recordings and panel
# stills. Never committed: a raw capture is hundreds of megabytes (GitHub's hard
# limit is 100MB), and even the re-encoded ones are reference material for one
# investigation, not part of the project. Describe what a capture showed in the
# bug log instead.
docs/evidence/

# Local release credentials are never kept in the repo (they live in ~/.config/onbridge/),
# but ignore the pattern anyway in case someone copies one here.
scripts/release/*.local.env
scripts/release/*.env
